{
  "name": "screen-ocr-translator-desktop",
  "productName": "Screen OCR Translator Desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MPL-2.0",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "org.screenocrtranslator.desktop",
    "productName": "Screen OCR Translator Desktop",
    "artifactName": "Screen-OCR-Translator-Desktop-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
