{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../src/*"],
      "../src/shared/i18n": ["src/compat/i18n.ts"],
      "../src/shared/fetch-with-modified-headers": ["src/compat/fetch-with-modified-headers.ts"]
    }
  },
  "include": ["src/**/*.ts", "vite.config.ts", "../.wxt/wxt.d.ts"]
}
